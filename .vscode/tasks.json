{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "pip install -e",
            "type": "shell",
            "presentation": {
                "echo": true,
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "command": "~/.venv/project-electrify/bin/pip install -e .",
            "options": {
                "statusbar": {
                    "label": "$(terminal) Install Self"
                }
            }
        },
        {
            "label": "requirements.txt",
            "type": "shell",
            "presentation": {
                "showReuseMessage": false,
                "clear": true
            },
            "command": "~/.venv/project-electrify/bin/pip install --no-cache-dir -r ./requirements.txt",
            "options": {
                "statusbar": {
                    "label": "$(terminal) Install Reqs"
                }
            }
        }
    ]
}
