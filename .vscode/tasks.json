{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run GUI",
            "type": "shell",
            "command": "./env/bin/python run_gui.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "QT Designer",
            "type": "shell",
            "command": "source ${workspaceFolder}/env/bin/activate && pyside6-designer",
            "presentation": {
                "reveal": "never"
            },
            "options": {
                "cwd": "${workspaceFolder}/electrify_ui/qt_screens/"
            },
            "isBackground": true
        },
        {
            "label": "pyside6-project",
            "type": "shell",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "command": "./scripts/pyside-build.sh",
        }
    ]
}
