{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run GUI",
            "type": "shell",
            "command": "./env/bin/python run_gui.py",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "options": {
                "statusbar": {
                    "label": "$(debug-start) GUI"
                }
            },
            "dependsOn": "pyside6-project"
        },
        {
            "label": "QT Designer",
            "type": "shell",
            "command": "source ${workspaceFolder}/env/bin/activate && pyside6-designer",
            "presentation": {
                "reveal": "never"
            },
            "options": {
                "cwd": "${workspaceFolder}/electrify_ui/qt_screens/",
                "statusbar": {
                    "label": "$(preview) QT Designer"
                }
            },
            "isBackground": true
        },
        {
            "label": "pyside6-project",
            "type": "shell",
            "presentation": {
                "echo": true,
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "command": "./scripts/pyside-build.sh",
            "options": {
                "statusbar": {
                    "label": "$(terminal) pyside-build.sh"
                }
            }
        },
        {
            "label": "pip install -e",
            "type": "shell",
            "presentation": {
                "echo": true,
                "reveal": "never",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": false
            },
            "command": "./env/bin/pip install -e .",
            "options": {
                "statusbar": {
                    "label": "$(terminal) pip install -e"
                }
            }
        }
    ]
}
